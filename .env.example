# Vite frontend — copy to `.env.local` to override. All values are optional.

# Backend API base. Leave empty to use the same-origin `/api` Vite proxy
# (see vite.config.js).
VITE_API_URL=

# Real market data provider used by src/api/marketApi.js (fetchMarketData).
# Leave empty until the provider is connected — the Markets page then keeps
# placeholders and never fabricates prices.
VITE_MARKET_API_URL=

# Market refresh interval in milliseconds (default: 80000).
VITE_MARKET_REFRESH_INTERVAL=80000

# DEVELOPMENT-ONLY auth bypass: "true" skips the login gate while running
# `npm run dev` so `/` opens directly on the dashboard (see
# src/utils/devAuthBypass.js and .env.development). Any other value or a
# missing variable keeps the normal Sign In / Sign Up flow. Not used by
# `vite build` — production auth is never affected.
VITE_DEV_AUTH_BYPASS=false

# Admin panel origin. The admin panel is a SEPARATE Vite app (see /admin);
# this app never renders it. When set, visiting /admin on the user app
# forwards to this origin (dev default: http://localhost:5174). Leave empty
# if your web server routes /admin to the admin build directly.
VITE_ADMIN_URL=