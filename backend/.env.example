# XPO backend — copy to .env and fill in values. NEVER commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL — local dev database (kept as-is; do not edit)
DATABASE_URL=postgresql://ankitsharma@localhost:5432/xpo_dev

# Neon (optional) — uncomment to point Prisma at the Neon branch instead
# of the local Postgres. The app runs on LOCAL dev DB by default.
# NEON_DATABASE_URL=postgresql://neondb_owner:npg_0VQLwjeKGO1E@ep-quiet-mouse-b4bggb73.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# CORS — comma separated allowed origins (Vite dev + preview servers)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5200,http://localhost:5300

# IBRLive (Forex) — key is server-side only, NEVER sent to React
IBRLIVE_API_KEY=
IBRLIVE_BASE_URL=https://api.ibrlive.com
FOREX_REFRESH_INTERVAL_SECONDS=80
FOREX_MONTHLY_REQUEST_LIMIT=35000
FOREX_WARNING_THRESHOLD=30000
FOREX_SYMBOLS=USDINR,EURINR,GBPINR,JPYINR,AUDINR,CADINR,CHFINR,SGDINR,AEDINR,NZDINR

# Crypto provider — leave empty until a provider is chosen (API returns 503)
CRYPTO_PROVIDER_URL=
CRYPTO_API_KEY=
CRYPTO_REFRESH_INTERVAL_SECONDS=60
# Symbols requested from the crypto provider (Part 4 target universe, 25)
CRYPTO_SYMBOLS=BTC,ETH,USDT,BNB,XRP,USDC,SOL,TRX,FIGR_HELOC,ZEC,HYPE,DOGE,XMR,USDS,LINK,ADA,AVAX,XLM,SUI,HBAR,TON,SHIB,LTC,BCH,DOT

# Seed admin (prisma/seed.js) — required to create the first admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
